# Homean Mac mini backup configuration. Copy to backup.env (mode 0600).
# backup.env is git-ignored; it holds no database or S3 secrets itself,
# those are read from backend/.env through Docker Compose.

# rclone remote path that receives encrypted snapshots. Must be off-host
# (another provider or another machine), never a folder on the Mac mini.
# Configure the remote first with `rclone config`.
BACKUP_REMOTE=b2:homean-backups/macmini

# age public key that encrypts every snapshot. Keep the matching private key
# OFF the Mac mini (password manager + printed copy). Without it no backup
# can be restored, so test it with restore_drill.sh before relying on it.
BACKUP_AGE_RECIPIENT=age1replacewithyourpublickey

# How long snapshots stay on the remote, and how many stay on local disk.
BACKUP_RETENTION_DAYS=30
BACKUP_LOCAL_KEEP=3

# Local staging directory for snapshots before upload.
BACKUP_LOCAL_DIR=/Users/hepang/homean-backups

# Docker Compose project that runs PostgreSQL and MinIO.
COMPOSE_PROJECT=homean-production
